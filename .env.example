# ============================================================
# Google Apps Script (backend Google Sheets)
# ============================================================

# URL triển khai Web App của Apps Script:
# Apps Script > Deploy > Manage deployments > lấy URL /exec.
# Chỉ dùng https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
# (hoặc /dev khi đang thử nghiệm).
# KHÔNG thêm tiền tố NEXT_PUBLIC_: URL này chỉ được dùng ở server.
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Token bí mật để server Next.js xác thực với Apps Script.
# Giá trị phải khớp chính xác Script Property APP_TOKEN trong Apps Script
# (Project Settings > Script Properties).
# Tạo token ngẫu nhiên tối thiểu 24 ký tự bằng: npm run secret
# KHÔNG thêm tiền tố NEXT_PUBLIC_ và không commit giá trị thật.
APPS_SCRIPT_TOKEN=replace-with-the-APP_TOKEN-script-property

# ============================================================
# Authentication
# ============================================================

# Bắt buộc, tối thiểu 32 ký tự. Tạo bằng: npm run secret
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Tùy chọn: ghi đè data/accounts.json khi deploy.
# Nên dùng biến này trên Vercel và KHÔNG commit file tài khoản thật.
# AUTH_USERS_JSON={"users":[{"username":"admin","name":"Quản trị viên","passwordHash":"$2b$12$...","role":"admin","active":true}]}
